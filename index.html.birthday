<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Happy Birthday Gift</title>
<style>
  body {
    margin: 0;
    background: linear-gradient(to top, #fceabb, #f8b500);
    overflow: hidden;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  /* Balloon styles */
  .balloon {
    position: absolute;
    bottom: -150px;
    width: 60px;
    height: 80px;
    background: radial-gradient(circle at 30% 30%, #ff4b5c, #c70039);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    opacity: 0.9;
    animation: floatUp linear infinite;
  }
  .balloon::after {
    content: '';
    position: absolute;
    bottom: -20px;
    left: 50%;
    width: 2px;
    height: 20px;
    background: #555;
    transform: translateX(-50%);
  }

  /* Different balloon colors */
  .balloon.blue {
    background: radial-gradient(circle at 30% 30%, #4a90e2, #003d99);
  }
  .balloon.green {
    background: radial-gradient(circle at 30% 30%, #7ed957, #3a7d00);
  }
  .balloon.yellow {
    background: radial-gradient(circle at 30% 30%, #ffec3d, #bfa900);
  }
  .balloon.purple {
    background: radial-gradient(circle at 30% 30%, #b366ff, #5a00b3);
  }

  /* Balloon animation */
  @keyframes floatUp {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0.9;
    }
    100% {
      transform: translateY(-110vh) translateX(20px);
      opacity: 0;
    }
  }

  /* Gift box container */
  .gift-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    width: 150px;
    height: 150px;
    perspective: 800px;
  }

  /* Gift box */
  .gift-box {
    width: 150px;
    height: 150px;
    background: #d32f2f;
    border-radius: 15px;
    position: relative;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    transform-style: preserve-3d;
    transition: transform 1s ease;
  }

  /* Gift lid */
  .gift-lid {
    position: absolute;
    top: 0;
    left: 0;
    width: 150px;
    height: 50px;
    background: #b71c1c;
    border-radius: 15px 15px 0 0;
    transform-origin: bottom center;
    transition: transform 1s ease;
    box-shadow: inset 0 3px 5px rgba(255,255,255,0.3);
  }

  /* Ribbon */
  .ribbon-vertical {
    position: absolute;
    top: 0;
    left: 65px;
    width: 20px;
    height: 150px;
    background: #ffeb3b;
    border-radius: 5px;
    box-shadow: inset 0 3px 5px rgba(255,255,255,0.6);
  }
  .ribbon-horizontal {
    position: absolute;
    top: 65px;
    left: 0;
    width: 150px;
    height: 20px;
    background: #ffeb3b;
    border-radius: 5px;
    box-shadow: inset 0 3px 5px rgba(255,255,255,0.6);
  }

  /* Opened state */
  .open .gift-lid {
    transform: rotateX(-120deg);
  }
  .open .gift-box {
    transform: translateY(30px);
  }

  /* Wishes container */
  .wishes {
    position: absolute;
    top: 220px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    text-align: center;
    font-size: 24px;
    color: #d32f2f;
    font-weight: bold;
    opacity: 0;
    transition: opacity 1s ease 1s;
    user-select: none;
  }
  .open ~ .wishes {
    opacity: 1;
  }

  /* Colorful wishes text */
  .wishes span {
    display: inline-block;
    animation: colorChange 3s infinite alternate;
  }
  .wishes span:nth-child(1) { animation-delay: 0s; color: #e91e63; }
  .wishes span:nth-child(2) { animation-delay: 0.3s; color: #9c27b0; }
  .wishes span:nth-child(3) { animation-delay: 0.6s; color: #3f51b5; }
  .wishes span:nth-child(4) { animation-delay: 0.9s; color: #2196f3; }
  .wishes span:nth-child(5) { animation-delay: 1.2s; color: #4caf50; }
  .wishes span:nth-child(6) { animation-delay: 1.5s; color: #ff9800; }
  .wishes span:nth-child(7) { animation-delay: 1.8s; color: #f44336; }

  @keyframes colorChange {
    0% { filter: brightness(1); }
    100% { filter: brightness(1.5); }
  }
</style>
</head>
<body>

<!-- Balloons -->
<div class="balloon" style="left: 10%; animation-duration: 12s;"></div>
<div class="balloon blue" style="left: 25%; animation-duration: 15s; animation-delay: 3s;"></div>
<div class="balloon green" style="left: 40%; animation-duration: 10s; animation-delay: 1s;"></div>
<div class="balloon yellow" style="left: 60%; animation-duration: 14s; animation-delay: 2s;"></div>
<div class="balloon purple" style="left: 80%; animation-duration: 13s; animation-delay: 4s;"></div>

<!-- Gift box -->
<div class="gift-container" id="gift">
  <div class="gift-box">
    <div class="gift-lid"></div>
    <div class="ribbon-vertical"></div>
    <div class="ribbon-horizontal"></div>
  </div>
</div>

<!-- Wishes -->
<div class="wishes">
  <span>H</span><span>a</span><span>p</span><span>p</span><span>y</span> 
  <span>B</span><span>i</span><span>r</span><span>t</span><span>h</span><span>d</span><span>a</span><span>y</span>!<br/>
  Wishing you joy, love, and happiness on your special day!
</div>

<script>
  const gift = document.getElementById('gift');
  gift.addEventListener('click', () => {
    gift.classList.toggle('open');
  });
</script>

</body>
</html>
